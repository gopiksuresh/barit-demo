# Copy to api/.env
DATABASE_URL="postgresql://barit:barit@localhost:5432/barit"
TEST_DATABASE_URL="postgresql://barit:barit@localhost:5432/barit_test"
PORT=3000

# Firebase — the demo-* project id works with the emulator, no real project needed
FIREBASE_PROJECT_ID=demo-barit
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Public URLs (used for QR codes and CORS)
GUEST_URL=http://localhost:4200
ADMIN_URL=http://localhost:4300
API_PUBLIC_URL=http://localhost:3000

# Image storage: "local" (api/uploads, dev) or "firebase" (Firebase Storage, prod)
STORAGE_DRIVER=local
# FIREBASE_STORAGE_BUCKET=barit-prod.appspot.com

# Razorpay — leave blank for stub mode (fake UPI sheet, no account needed)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
